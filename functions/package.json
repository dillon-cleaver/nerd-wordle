{
  "name": "functions",
  "scripts": {
    "lint": "eslint . --ext .js,.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "shell": "pnpm run build && firebase functions:shell",
    "emulator:serve": "pnpm run build && firebase emulators:start --only functions,firestore",
    "emulator:start": "pnpm run build && firebase emulators:start --only functions,firestore --import=./emulator-data --export-on-exit=./emulator-data",
    "emulator:reset": "rm -rf ./emulator-data && firebase emulators:exec --only firestore 'firebase firestore:delete --all-collections -f'",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "deploy:indexes": "firebase deploy --only firestore:indexes",
    "deploy:all": "firebase deploy",
    "logs": "firebase functions:log",
    "migrate:from-prod": "pnpm run build && FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node lib/functions/src/migrations/import-from-production.js",
    "seed:alpha-beta": "pnpm run build && node lib/migrations/seed-alpha-beta-puzzles.js",
    "seed:production": "pnpm run build && node lib/migrations/seed-production-puzzles.js",
    "dev:prod-data": "firebase emulators:exec --only functions,firestore 'pnpm run migrate:from-prod' --export-on-exit=./emulator-data"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^4.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.7.3"
  },
  "private": true,
  "config": {
    "engines-strict": false
  }
}
