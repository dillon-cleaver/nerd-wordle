{
  "name": "functions",
  "scripts": {
    "lint": "eslint . --ext .js,.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "pnpm run build && firebase emulators:start --only functions,firestore",
    "shell": "pnpm run build && firebase functions:shell",
    "start": "pnpm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "migrate:words": "pnpm run build && FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node lib/functions/src/migrations/seed-words.js",
    "migrate:puzzles": "pnpm run build && FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 node lib/functions/src/migrations/seed-daily-puzzles.js",
    "migrate:all": "pnpm run migrate:words && pnpm run migrate:puzzles",
    "migrate:words:prod": "pnpm run build && node lib/functions/src/migrations/seed-words.js",
    "migrate:puzzles:prod": "pnpm run build && node lib/functions/src/migrations/seed-daily-puzzles.js",
    "migrate:all:prod": "pnpm run migrate:words:prod && pnpm run migrate:puzzles:prod"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "@google-cloud/functions-framework": "^4.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.9",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.7.3"
  },
  "private": true,
  "config": {
    "engines-strict": false
  }
}
