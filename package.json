{
  "name": "nerd-wordle",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "clean": "expo start --clear",
    "test": "jest --watchAll",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "build:dictionary": "node scripts/build-dictionary.js",
    "deploy:dictionary": "pnpm run build:dictionary && firebase deploy --only hosting",
    "validate:words": "node scripts/build-dictionary.js --validate",
    "update:words": "node scripts/update-words.js --env production --deploy --force",
    "update:words:emulator": "node scripts/update-words.js --env emulator",
    "update:words:validate": "node scripts/update-words.js --env emulator --validate",
    "update:words:production": "node scripts/update-words.js --env production --deploy --force",
    "update:words:cdn-only": "pnpm run build:dictionary && firebase deploy --only hosting && echo '✅ CDN dictionary updated'",
    "deploy:web": "pnpm run env:production && pnpm run build:dictionary && expo export --platform web && eas deploy",
    "deploy:all": "cd functions && pnpm run deploy:functions && cd .. && pnpm run deploy:web",
    "dev:web": "pnpm run env:development && expo start --web",
    "dev:web:bypass": "pnpm run env:testing && expo start --web",
    "dev:ios": "pnpm run env:development && expo start --ios",
    "dev:ios:bypass": "pnpm run env:testing && expo start --ios",
    "dev:android": "pnpm run env:development && expo start --android",
    "dev:android:bypass": "pnpm run env:testing && expo start --android",
    "env:development": "node scripts/env-helper.js development",
    "env:testing": "node scripts/env-helper.js testing",
    "env:production": "node scripts/env-helper.js production"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.0",
    "@expo/metro-runtime": "~5.0.4",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/drawer": "^7.3.9",
    "@react-navigation/native": "^7.0.14",
    "expo": "~53.0.20",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.7",
    "expo-crypto": "~14.1.5",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.10",
    "expo-updates": "~0.28.17",
    "expo-web-browser": "~14.2.0",
    "firebase": "^11.8.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/metro-config": "^0.20.17",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.14",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~9.2.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.9",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
