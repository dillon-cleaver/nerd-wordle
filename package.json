{
  "name": "nerd-wordle",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "clean": "expo start --clear",
    "test": "jest --watchAll",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "words:add": "node scripts/add-word.js",
    "words:validate": "node scripts/build-dictionary.js --validate",
    "words:verify-bundle": "node scripts/verify-bundle-size.js",
    "words:check-bundle": "node scripts/check-bundle-size.js",
    "analyze:bundle": "node scripts/analyze-bundle.js",
    "analyze:deps": "node scripts/check-unused-deps.js",
    "words:deploy": "pnpm words:validate && node scripts/auto-version-dictionary.js && firebase deploy --only hosting && echo '✅ New words deployed to CDN with auto-versioning!'",
    "words:admin": "cd functions && pnpm run seed:words:production",
    "dev": "pnpm run env:development && expo start",
    "dev:web": "pnpm run env:development && expo start --web",
    "dev:bypass": "pnpm run env:testing && expo start",
    "deploy:app": "pnpm run env:production && expo export --platform web && eas deploy",
    "deploy:backend": "cd functions && pnpm run deploy:all",
    "deploy:all": "pnpm deploy:backend && pnpm deploy:app",
    "build:dictionary": "node scripts/build-dictionary.js",
    "env:development": "node scripts/env-helper.js development",
    "env:testing": "node scripts/env-helper.js testing",
    "env:production": "node scripts/env-helper.js production"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.0",
    "@expo/metro-runtime": "~5.0.4",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/drawer": "^7.3.9",
    "@react-navigation/native": "^7.0.14",
    "expo": "~53.0.20",
    "expo-constants": "~17.1.7",
    "expo-crypto": "~14.1.5",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-router": "~5.1.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-system-ui": "~5.0.10",
    "expo-updates": "~0.28.17",
    "firebase": "^11.8.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/metro-config": "^0.20.17",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.14",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~9.2.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.9",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
