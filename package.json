{
  "name": "nerd-wordle",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "build": "expo export:web",
    "prepare": "husky",
    "// 📱 EAS Update Commands - Push code updates to live apps without app store": "",
    "eas:update": "eas update --channel production --message \"Production update\"",
    "eas:update:preview": "eas update --channel preview --message \"Preview update\"",
    "eas:update:main": "eas update --branch main --message \"Main branch update\"",
    "eas:status": "eas branch:list && eas channel:list",
    "// 🏗️ EAS Build Commands - Create app store builds": "",
    "eas:build:android": "eas build --platform android --profile production",
    "eas:build:ios": "eas build --platform ios --profile production",
    "eas:build:preview": "eas build --platform all --profile preview",
    "eas:build:all": "eas build --platform all --profile production",
    "// 🚀 EAS Submit Commands - Upload to app stores": "",
    "eas:submit:android": "eas submit --platform android",
    "eas:submit:ios": "eas submit --platform ios",
    "eas:submit:all": "eas submit --platform all",
    "// 🌐 EAS Hosting Commands - Deploy web apps": "",
    "expo:export": "expo export --platform web",
    "eas:deploy": "eas deploy",
    "web:deploy": "pnpm run expo:export && pnpm run eas:deploy",
    "web:deploy:prod": "pnpm run expo:export && eas deploy --alias production",
    "// 🔥 Firebase Commands - Backend services": "",
    "firebase:serve": "cd functions && pnpm run serve",
    "firebase:deploy": "cd functions && pnpm run build && firebase deploy --only functions",
    "firebase:deploy:all": "cd functions && pnpm run build && firebase deploy",
    "firebase:logs": "firebase functions:log",
    "firebase:shell": "cd functions && pnpm run shell",
    "firebase:emulators": "firebase emulators:start",
    "// 🗄️ Database Migration Commands - Seed Firestore with data": "",
    "migrate:words": "cd functions && pnpm run migrate:words",
    "migrate:puzzles": "cd functions && pnpm run migrate:puzzles",
    "migrate:all": "cd functions && pnpm run migrate:all",
    "migrate:words:prod": "cd functions && pnpm run migrate:words:prod",
    "migrate:puzzles:prod": "cd functions && pnpm run migrate:puzzles:prod",
    "migrate:all:prod": "cd functions && pnpm run migrate:all:prod",
    "// ⚡ Development Workflows - Common combinations": "",
    "dev:full": "pnpm run firebase:serve & pnpm start",
    "dev:clean": "expo start --clear",
    "dev:reset": "pnpm run reset-project && pnpm start",
    "deploy:backend": "pnpm run firebase:deploy",
    "deploy:web": "pnpm run web:deploy:prod",
    "deploy:mobile": "pnpm run eas:update",
    "deploy:all": "pnpm run deploy:backend && pnpm run deploy:web && pnpm run deploy:mobile",
    "// 🛠️ Utility Commands - Helpful development tools": "",
    "clean": "expo start --clear && watchman watch-del-all",
    "deps:check": "npx expo doctor",
    "deps:upgrade": "npx expo upgrade",
    "env:check": "eas whoami && firebase projects:list"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@babel/runtime": "^7.27.0",
    "@expo/metro-runtime": "~5.0.4",
    "@expo/vector-icons": "^14.0.2",
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/drawer": "^7.3.9",
    "@react-navigation/native": "^7.0.14",
    "expo": "~53.0.20",
    "expo-blur": "~14.1.5",
    "expo-constants": "~17.1.7",
    "expo-device": "~7.1.4",
    "expo-font": "~13.3.2",
    "expo-haptics": "~14.1.4",
    "expo-linking": "~7.1.7",
    "expo-router": "~5.1.4",
    "expo-splash-screen": "~0.30.10",
    "expo-status-bar": "~2.2.3",
    "expo-symbols": "~0.4.5",
    "expo-system-ui": "~5.0.10",
    "expo-updates": "~0.28.17",
    "expo-web-browser": "~14.2.0",
    "firebase": "^11.8.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.5",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-web": "~0.20.0",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/metro-config": "^0.20.17",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.0.14",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^9.31.0",
    "eslint-config-expo": "~9.2.0",
    "husky": "^9.1.7",
    "jest": "^29.2.1",
    "jest-expo": "~53.0.9",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.3.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
